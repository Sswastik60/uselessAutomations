{
    "schema_version": 1,
    "id": "coding_mode",
    "name": "Coding Mode",
    "description": "Launch editor, open terminal, and set up workspace.",
    "icon": "💻",
    "hotkey": "CTRL+ALT+C",
    "enabled": true,
    "actions": [
        {
            "type": "process.launch",
            "name": "Launch VS Code",
            "params": {
                "application": "vscode"
            },
            "on_failure": "continue"
        },
        {
            "type": "notification.show",
            "name": "Notify Ready",
            "params": {
                "title": "💻 Coding Mode Active",
                "message": "Development workspace initialized."
            },
            "on_failure": "continue"
        }
    ]
}
